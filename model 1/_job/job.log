Sending keys: ['cat >> src/_pytest/explain_deselections.py << \'PYEOF\'\n\n\ndef _load_baseline_data(settings, updating=False):\n    if not settings.baseline:\n        return None\n    path = settings.baseline\n    if not os.path.exists(path):\n        if updating:\n            return {"total_deselected": 0, "reasons": {}}\n        raise UsageError("file not found")\n    try:\n        with open(path, encoding="utf-8") as f:\n            data = json.load(f)\n    except (ValueError, json.JSONDecodeError):\n        raise UsageError("invalid JSON") from None\n    counts = {}\n    for r in data.get("reasons", []):\n        counts[r.get("reason")] = r.get("count", 0)\n    return {\n        "total_deselected": data.get("total_deselected", 0),\n        "reasons": counts,\n    }\n\n\ndef _sort_key(entry, sort_by):\n    reason = entry["reason"]\n    if sort_by == "reason":\n        return (reason,)\n    if sort_by == "count":\n        return (-entry["count"], reason)\n    if sort_by == "delta":\n        delta = entry["delta"] if entry["delta"] is not None else entry["count"]\n        return (-delta, reason)\n    return (reason,)\n\n\ndef _order_nodeids(nodeids, settings):\n    if settings.nodeids_order == "sorted":\n        return sorted(nodeids)\n    return list(nodeids)\n\n\ndef _compute_entries(config, settings, baseline):\n    result = config.stash.get(result_key, None)\n    if result is None:\n        result = {"reasons": {}, "total": 0}\n    reasons = result["reasons"]\n\n    baseline_reasons = baseline["reasons"] if baseline else None\n\n    entries = []\n    seen = set()\n    for reason_str, r in reasons.items():\n        count = len(r.nodeids)\n        seen.add(reason_str)\n        if baseline_reasons is not None:\n            bc = baseline_reasons.get(reason_str)\n            if bc is None:\n                delta = count\n                bcount = None\n            else:\n                bcount = bc\n                delta = count - bc\n        else:\n            bcount = None\n            delta = None\n        entries.append({\n            "reason": reason_str,\n            "count": count,\n            "nodeids": r.nodeids,\n            "baseline_count": bcount,\n            "delta": delta,\n        })\n\n    # reasons that vanished (present in baseline, absent now) are not shown.\n\n    return entries, result["total"]\n\n\ndef _filtered_entries(entries, settings):\n    out = []\n    for e in entries:\n        if settings.reason_filter is not None:\n            if not settings.reason_filter.search(e["reason"]):\n                continue\n        if settings.min_count is not None and e["count"] < settings.min_count:\n            continue\n        if settings.min_delta is not None:\n            d = e["delta"] if e["delta"] is not None else e["count"]\n            if d < settings.min_delta:\n                continue\n        out.append(e)\n    out.sort(key=lambda e: _sort_key(e, settings.sort_by))\n    if settings.reasons_cap:\n        out = out[: settings.reasons_cap]\n    return out\n\n\ndef _delta_suffix(entry, has_baseline):\n    if not has_baseline:\n        return ""\n    if entry["baseline_count"] is None:\n        return " (new)"\n    delta = entry["delta"]\n    if delta > 0:\n        return f" (+{delta})"\n    if delta < 0:\n        return f" ({delta})"\n    return " (+0)"\nPYEOF\necho done\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
