Running collect hook in service 'main': '# Where the artifacts go, and whether /logs is usable at all. A stale bind mount fails\n# at `mkdir` with "cannot stat", so the probe is a real write rather than a -d test.\nOUT=/logs/artifacts\nFALLBACK=0\nmkdir -p "$OUT" 2>/dev/null || true\n# Redirection before the target, so the probe\'s own failure message is swallowed.\n# Written the other way round, `>` is applied first and prints to the real stderr -\n# which harbor merges into stdout, putting noise ahead of the sentinels below.\nif ! : 2>/dev/null > "$OUT/.probe"; then\n  FALLBACK=1\n  OUT=/tmp/harbor-agent-capture\n  mkdir -p "$OUT"\nfi\nrm -f "$OUT/.probe" 2>/dev/null || true\n\nLOG="$OUT/agent.capture.log"\nexec 2>>"$LOG"\nset -x\n\n# These images ship a repo owned by root; if the hook runs as any other user git\n# refuses with \'dubious ownership\' and exits 128, which looks identical to\n# \'no repo here\'. Allowing every path is safe in a throwaway container.\ngit config --global --add safe.directory \'*\' || true\nid || true\ngit --version || true\n\nROOT=""\nfor d in /app /app/* /workspace /src; do\n  [ -d "$d" ] || continue\n  if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then ROOT="$d"; break; fi\ndone\nif [ -z "$ROOT" ]; then\n  ROOT=$(dirname "$(find /app /workspace /src -maxdepth 3 -name .git -print -quit 2>/dev/null)" 2>/dev/null)\n  case "$ROOT" in .|"") ROOT="" ;; esac\nfi\n\nif [ -z "$ROOT" ]; then\n  { echo "no git repo found"; ls -a /app 2>&1 | head -40; } > "$OUT/agent.patch.error"\nelse\n  echo "$ROOT" > "$OUT/agent.repo_root"\n  git -C "$ROOT" add -A -N || true\n  # Diff against HEAD, not the index. `add -A -N` marks new files intent-to-add but\n  # *stages* deletions, so a bare `git diff` (index vs worktree) sees index and\n  # worktree agreeing about a deleted file and omits it entirely - silently losing\n  # every deletion from the patch. `git diff HEAD` covers modifications, additions\n  # and deletions together.\n  git -C "$ROOT" diff --binary HEAD > "$OUT/agent.patch" || true\n  git -C "$ROOT" status --porcelain > "$OUT/agent.status" || true\n  git -C "$ROOT" diff --stat HEAD > "$OUT/agent.diffstat" || true\nfi\necho "capture finished, patch bytes: $(wc -c < "$OUT/agent.patch" 2>/dev/null || echo none)" >> "$LOG"\n\n# /logs was unwritable, so nothing above will be collected. Hand the diff to harbor\n# through stdout instead, and exit non-zero so harbor actually logs it - on a zero exit\n# it logs "completed" and discards the output. `run_agents.recover_patch_from_log` reads\n# it back out of trial.log. Tracing goes to $LOG, not stderr, so it cannot land between\n# the sentinels: harbor merges stderr into stdout.\nif [ "$FALLBACK" = 1 ]; then\n  set +x\n  echo "HARBOR_PIPELINE_PATCH_FALLBACK_BEGIN"\n  cat "$OUT/agent.patch" 2>/dev/null || true\n  echo ""\n  echo "HARBOR_PIPELINE_PATCH_FALLBACK_END"\n  echo "capture wrote to $OUT because /logs was unwritable; diff emitted on stdout" >&2\n  exit 1\nfi\n'
