ecorded.</p>")\n        parts.append("</body></html>")\n        return "\\n".join(parts) + "\\n"\n    parts.append("<table>")\n    if has_baseline:\n        parts.append("<tr><th>Reason</th><th>Count</th><th>Baseline</th><th>Delta</th></tr>")\n        for e in entries:\n            bc = e["baseline_count"] if e["baseline_count"] is not None else 0\n            d = e["delta"] if e["delta"] is not None else e["count"]\n            parts.append(f"<tr><td>{e[\'reason\']}</td><td>{e[\'count\']}</td><td>{bc}</td><td>{_signed(d)}</td></tr>")\n    else:\n        parts.append("<tr><th>Reason</th><th>Count</th></tr>")\n        for e in entries:\n            parts.append(f"<tr><td>{e[\'reason\']}</td><td>{e[\'count\']}</td></tr>")\n    parts.append("</table>")\n    if settings.verbose and settings.max_nodeids > 0:\n        for e in entries:\n            shown, more = _nodeids_for_report(e, settings)\n            parts.append(f"<h3>{e[\'reason\']}</h3>")\n            parts.append("<ul>")\n            for nid in shown:\n                parts.append(f"<li>{nid}</li>")\n            if more > 0:\n                parts.append(f"<li>(+{more} more)</li>")\n            parts.append("</ul>")\n    parts.append("</body></html>")\n    return "\\n".join(parts) + "\\n"\n\n\ndef _generate_report(fmt, entries, settings, has_baseline, total, baseline):\n    if fmt == "text":\n        return _report_text(entries, settings, has_baseline, total)\n    if fmt == "json":\n        return _report_json(entries, settings, has_baseline, total, baseline)\n    if fmt == "csv":\n        return _report_csv(entries, settings, has_baseline, total)\n    if fmt in ("md", "markdown"):\n        return _report_md(entries, settings, has_baseline, total)\n    if fmt in ("html", "htm"):\n        return _report_html(entries, settings, has_baseline, total)\n    return _report_text(entries, settings, has_baseline, total)\nPYEOF\necho done\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
