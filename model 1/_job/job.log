t_or_ini_int(\n            fie, None, "--explain-deselections-fail-if-exceeds", minimum=0,\n        )\n\n        mc = opt.explain_deselections_min_count\n        if mc is None:\n            mc = config.getini("explain_deselections_min_count")\n        self.min_count = _opt_or_ini_int(\n            mc, None, "--explain-deselections-min-count", minimum=1,\n        )\n\n        self.reasons_cap = _opt_or_ini_int(\n            opt.explain_deselections_reasons_cap, None,\n            "--explain-deselections-reasons-cap", minimum=0,\n        )\n\n        self.baseline = opt.explain_deselections_baseline\n\n        md = opt.explain_deselections_min_delta\n        self.min_delta = _opt_or_ini_int(\n            md, None, "--explain-deselections-min-delta", minimum=0,\n        )\n        if self.min_delta is not None and not self.baseline:\n            raise UsageError("requires --explain-deselections-baseline")\n\n        # format\n        fmt = opt.explain_deselections_format\n        from_ini = False\n        if fmt is None:\n            fmt = config.getini("explain_deselections_format")\n            from_ini = fmt not in (None, "")\n        if fmt in (None, ""):\n            fmt = "text"\n        if fmt not in ("text", "json", "csv"):\n            raise UsageError("choose from text, json, csv")\n        self.default_format = fmt\n        self._format_from_ini = from_ini\n\n        self.json_pretty = bool(opt.explain_deselections_json_pretty)\n        self.json_no_nodeids = bool(opt.explain_deselections_json_no_nodeids)\n        self.csv_with_delta = bool(opt.explain_deselections_csv_with_delta)\n\n        self.outputs = list(opt.explain_deselections_output or [])\n\n        # default format needs path for json/csv\n        if self.default_format in ("json", "csv"):\n            has_stdout_only = False\n            if not self.outputs:\n                raise UsageError("requires --explain-deselections-output")\n\n        junit = opt.explain_deselections_junit\n        if junit is None:\n            junit = config.getini("explain_deselections_junit")\n        if junit in (None, ""):\n            junit = None\n        if junit is not None:\n            if junit not in ("none", "properties", "system-out"):\n                raise UsageError("choose from none, properties, system-out")\n            if not config.option.xmlpath:\n                raise UsageError("requires --junitxml")\n        self.junit = junit\n\n        self.fail_on_new = bool(opt.explain_deselections_fail_on_new)\n        self.update_baseline = bool(opt.explain_deselections_update_baseline)\n        if self.fail_on_new and not self.baseline:\n            raise UsageError("requires --explain-deselections-baseline")\n        if self.update_baseline and not self.baseline:\n            raise UsageError("requires --explain-deselections-baseline")\n\n\ndef _int_opt(raw, default, name, minimum):\n    if raw in (None, ""):\n        return default\n    try:\n        val = int(raw)\n    except (TypeError, ValueError):\n        raise UsageError(f"{name}: invalid int value") from None\n    if minimum is not None and val < minimum:\n        raise UsageError(f"must be >= {minimum}")\n    return val\n\n\ndef _opt_or_ini_int(raw, default, name, minimum):\n    return _int_opt(raw, default, name, minimum=minimum)\nPYEOF\necho done\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
