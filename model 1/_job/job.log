Sending keys: ['cat >> src/_pytest/explain_deselections.py << \'PYEOF\'\n\n\nsettings_key: StashKey = StashKey()\n\n\n@hookimpl(trylast=True)\ndef pytest_configure(config: Config) -> None:\n    settings = Settings(config)\n    config.stash[settings_key] = settings\n\n\ndef _build_selectors(config: Config):\n    """Return list of (reason, predicate) in precedence order.\n\n    predicate(item) -> True if this selector deselects the item.\n    """\n    from _pytest.mark import KeywordMatcher\n    from _pytest.mark import MarkMatcher\n    from _pytest.mark.expression import Expression\n\n    selectors = []\n\n    # --deselect entries in CLI order (highest precedence)\n    deselect = config.getoption("deselect") or []\n    for prefix in deselect:\n        def make_pred(prefix):\n            return lambda item: item.nodeid.startswith(prefix)\n        selectors.append((f"--deselect {prefix}", make_pred(prefix)))\n\n    # -k\n    keywordexpr = (config.option.keyword or "").lstrip()\n    if keywordexpr:\n        try:\n            kexpr = Expression.compile(keywordexpr)\n        except SyntaxError:\n            kexpr = None\n        if kexpr is not None:\n            def kpred(item, kexpr=kexpr):\n                return not kexpr.evaluate(KeywordMatcher.from_item(item))\n            selectors.append((f"-k {keywordexpr}", kpred))\n\n    # -m\n    matchexpr = config.option.markexpr or ""\n    if matchexpr:\n        try:\n            mexpr = Expression.compile(matchexpr)\n        except SyntaxError:\n            mexpr = None\n        if mexpr is not None:\n            def mpred(item, mexpr=mexpr):\n                return not mexpr.evaluate(MarkMatcher.from_markers(item.iter_markers()))\n            selectors.append((f"-m {matchexpr}", mpred))\n\n    return selectors\n\n\n@hookimpl(wrapper=True)\ndef pytest_collection_modifyitems(items: list[Item], config: Config):\n    settings = config.stash.get(settings_key, None)\n    if settings is None or not settings.enabled:\n        result = yield\n        return result\n\n    original = list(items)\n    result = yield\n\n    remaining_ids = {item.nodeid for item in items}\n    deselected_items = [it for it in original if it.nodeid not in remaining_ids]\n\n    selectors = _build_selectors(config)\n\n    reasons: dict[str, Reason] = {}\n    total = 0\n    for item in deselected_items:\n        for reason_str, pred in selectors:\n            try:\n                matched = pred(item)\n            except Exception:\n                matched = False\n            if matched:\n                r = reasons.get(reason_str)\n                if r is None:\n                    r = Reason(reason_str)\n                    reasons[reason_str] = r\n                r.nodeids.append(item.nodeid)\n                total += 1\n                break\n\n    config.stash[result_key] = {\n        "reasons": reasons,\n        "total": total,\n    }\n    return result\nPYEOF\necho done\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
