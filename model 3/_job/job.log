t None else (junit_ini if junit_ini != "" else None)\n        if junit_val is not None:\n            if junit_val not in ("none", "properties", "system-out"):\n                raise UsageError("choose from none, properties, system-out")\n            self.junit = junit_val\n        else:\n            self.junit = "none"\n\n        xmlpath = config.option.xmlpath\n        if self.junit != "none" and not xmlpath:\n            raise UsageError("requires --junitxml")\n\n        self.baseline_file: str | None = config.getoption("explain_deselections_baseline")\n        self.fail_on_new: bool = bool(config.getoption("explain_deselections_fail_on_new"))\n        self.update_baseline: bool = bool(config.getoption("explain_deselections_update_baseline"))\n\n        if self.min_delta is not None and not self.baseline_file:\n            raise UsageError("requires --explain-deselections-baseline")\n        if self.fail_on_new and not self.baseline_file:\n            raise UsageError("requires --explain-deselections-baseline")\n        if self.update_baseline and not self.baseline_file:\n            raise UsageError("requires --explain-deselections-baseline")\n\n        # Load baseline if present\n        self.baseline_data: dict[str, Any] | None = None\n        self.baseline_reasons: dict[str, int] = {}\n        self.baseline_total: int = 0\n\n        if self.baseline_file:\n            if not os.path.exists(self.baseline_file):\n                if not self.update_baseline:\n                    raise UsageError("file not found")\n            else:\n                try:\n                    with open(self.baseline_file, encoding="utf-8") as f:\n                        self.baseline_data = json.load(f)\n                except Exception:\n                    raise UsageError("invalid JSON")\n\n                if not isinstance(self.baseline_data, dict):\n                    raise UsageError("invalid JSON")\n\n                self.baseline_total = self.baseline_data.get("total_deselected", 0)\n                reasons_arr = self.baseline_data.get("reasons", [])\n                if isinstance(reasons_arr, list):\n                    for r_item in reasons_arr:\n                        if isinstance(r_item, dict) and "reason" in r_item and "count" in r_item:\n                            self.baseline_reasons[r_item["reason"]] = r_item["count"]\n\n        # Track deselected items per reason: reason -> list of nodeids\n        self.deselected_by_reason: collections.OrderedDict[str, list[str]] = collections.OrderedDict()\n        self.total_deselected: int = 0\n\n    def record_deselected(self, reason: str, items: Sequence[Item]) -> None:\n        if reason not in self.deselected_by_reason:\n            self.deselected_by_reason[reason] = []\n        nodeids = [item.nodeid for item in items]\n        self.deselected_by_reason[reason].extend(nodeids)\n        self.total_deselected += len(items)\n\n    def get_processed_reasons() -> list[dict[str, Any]]:\n        has_baseline = self.baseline_file is not None and (self.baseline_data is not None or self.update_baseline)\n\n        raw_reasons = []\n        for reason, nids in self.deselected_by_reason.items():\n            if self.nodeids_order == "sorted":\n                ordered_nids = sorted(nids)\n            else:\n                ordered_nids = list(nids)\n\n            cnt = len(nids)\n            r_info: dict[str, Any] = {\n                "reason": reason,\n                "count": cnt,\n                "raw_nodeids": ordered_nids,\n                "nodeids": ordered_nids[: self.max_nodeids] if self.max_nodeids > 0 else [],\n            }\n\n            if has_baseline:\n                if reason in self.baseline_reasons:\n                    b_cnt = self.baseline_reasons[reason]\n                    r_info["baseline_count"] = b_cnt\n                    r_info["delta"] = cnt - b_cnt\n                    r_info["is_new"] = False\n                else:\n                    r_info["baseline_count"] = 0\n                    r_info["delta"] = cnt\n                    r_info["is_new"] = True\n\n            raw_reasons.append(r_info)\n\n        # 1. Reason filter regex\n        if self.reason_filter:\n            pattern = re.compile(self.reason_filter)\n            raw_reasons = [r for r in raw_reasons if pattern.search(r["reason"])]\n\n        # 2. Min count\n        if self.min_count is not None:\n            raw_reasons = [r for r in raw_reasons if r["count"] >= self.min_count]\n\n        # 3. Min delta\n        if self.min_delta is not None and has_baseline:\n            raw_reasons = [r for r in raw_reasons if abs(r["delta"]) >= self.min_delta]\n\n        # 4. Sort\n        if self.sort_by == "reason":\n            raw_reasons.sort(key=lambda r: r["reason"])\n        elif self.sort_by == "count":\n            raw_reasons.sort(key=lambda r: (-r["count"], r["reason"]))\n        elif self.sort_by == "delta":\n            def delta_key(r: dict[str, Any]) -> tuple[int, str]:\n                d = r.get("delta", r["count"]) if has_baseline else r["count"]\n                return (-d, r["reason"])\n            raw_reasons.sort(key=delta_key)\n\n        # 5. Cap\n        if self.reasons_cap is not None and self.reasons_cap > 0:\n            raw_reasons = raw_reasons[: self.reasons_cap]\n\n        return raw_reasons\n\n\ndef pytest_configure(config: Config) -> None:\n    if is_explain_deselections_enabled(config):\n        state = ExplainDeselectionsState(config)\n        config.stash[explain_deselections_key] = state\n\n\n@hookimpl(tryfirst=True)\ndef pytest_collection_modifyitems(items: list[Item], config: Config) -> None:\n    state = config.stash.get(explain_deselections_key, None)\n    if state is None:\n        return\n\n    # Evaluate selectors in strict precedence order:\n    # 1. --deselect entries in CLI order\n    # 2. -k expression\n    # 3. -m expression\n\n    deselect_prefixes = config.getoption("deselect") or []\n    keywordexpr = config.option.keyword.lstrip() if config.option.keyword else ""\n    markexpr = config.option.markexpr or ""\n\n    k_expr = _parse_expression(keywordexpr, "Wrong expression passed to \'-k\'") if keywordexpr else None\n    m_expr = _parse_expression(markexpr, "Wrong expression passed to \'-m\'") if markexpr else None\n\n    remaining: list[Item] = []\n    deselected_by_reason: collections.OrderedDict[str, list[Item]] = collections.OrderedDict()\n\n    for item in items:\n        # Check --deselect prefixes in order\n        deselected_reason = None\n        for prefix in deselect_prefixes:\n            if item.nodeid.startswith(prefix):\n                deselected_reason = f"--deselect {prefix}"\n                break\n\n        # Check -k expression\n        if deselected_reason is None and k_expr is not None:\n            if not k_expr.evaluate(KeywordMatcher.from_item(item)):\n                deselected_reason = f"-k {keywordexpr}"\n\n        # Check -m expression\n        if deselected_reason is None and m_expr is not None:\n            if not m_expr.evaluate(MarkMatcher.from_markers(item.iter_markers())):\n                deselected_reason = f"-m {markexpr}"\n\n        if deselected_reason is not None:\n            if deselected_reason not in deselected_by_reason:\n                deselected_by_reason[deselected_reason] = []\n            deselected_by_reason[deselected_reason].append(item)\n        else:\n            remaining.append(item)\n\n    # Record deselections in state\n    all_deselected = []\n    for reason, des_items in deselected_by_reason.items():\n        state.record_deselected(reason, des_items)\n        all_deselected.extend(des_items)\n\n    if all_deselected:\n        config.hook.pytest_deselected(items=all_deselected)\n        items[:] = remaining\n\n\ndef _format_text_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n    lines = []\n\n    for r in reasons:\n        line = f"deselected by {r[\'reason\']}: {r[\'count\']}"\n        if has_baseline:\n            if r.get("is_new"):\n                line += " (new)"\n            else:\n                d = r.get("delta", 0)\n                if d >= 0:\n                    line += f" (+{d})"\n                else:\n                    line += f" ({d})"\n        lines.append(line)\n\n        if state.verbose and state.max_nodeids > 0 and r.get("raw_nodeids"):\n            raw_nids = r["raw_nodeids"]\n            for nid in raw_nids[: state.max_nodeids]:\n                lines.append(f"  {nid}")\n            if len(raw_nids) > state.max_nodeids:\n                diff = len(raw_nids) - state.max_nodeids\n                lines.append(f"  (+{diff} more)")\n\n    return "\\n".join(lines)\n\n\ndef _format_json_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    data: dict[str, Any] = {\n        "schema_version": 1,\n        "total_deselected": state.total_deselected,\n    }\n    if has_baseline:\n        data["baseline_total_deselected"] = state.baseline_total\n        data["total_delta"] = state.total_deselected - state.baseline_total\n\n    reasons_list = []\n    for r in reasons:\n        rec: dict[str, Any] = {\n            "reason": r["reason"],\n            "count": r["count"],\n        }\n        if not state.json_no_nodeids:\n            if state.max_nodeids > 0:\n                rec["nodeids"] = r["raw_nodeids"][: state.max_nodeids]\n            else:\n                rec["nodeids"] = []\n        if has_baseline:\n            rec["baseline_count"] = r.get("baseline_count", 0)\n            rec["delta"] = r.get("delta", r["count"])\n        reasons_list.append(rec)\n\n    data["reasons"] = reasons_list\n\n    if state.json_pretty:\n        return json.dumps(data, indent=2) + "\\n"\n    else:\n        return json.dumps(data) + "\\n"\n\n\ndef _format_csv_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n    include_delta = state.csv_with_delta\n\n    out = io.StringIO()\n    writer = csv.writer(out)\n\n    if include_delta:\n        writer.writerow(["reason", "count", "baseline_count", "delta"])\n        for r in reasons:\n            writer.writerow([\n                r["reason"],\n                r["count"],\n                r.get("baseline_count", 0) if has_baseline else 0,\n                r.get("delta", r["count"]) if has_baseline else r["count"],\n            ])\n    else:\n        writer.writerow(["reason", "count"])\n        for r in reasons:\n            writer.writerow([r["reason"], r["count"]])\n\n    return out.getvalue()\n\n\ndef _format_md_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    lines = [\n        "# Deselection Report",\n        "",\n        f"**Total deselected:** {state.total_deselected}",\n        "",\n    ]\n    if not reasons or state.total_deselected == 0:\n        lines.append("No deselections recorded.")\n    else:\n        if has_baseline:\n            lines.append("| Reason | Count | Baseline | Delta |")\n            lines.append("| --- | --- | --- | --- |")\n            for r in reasons:\n                b_cnt = r.get("baseline_count", 0)\n                if r.get("is_new"):\n                    d_str = "(new)"\n                else:\n                    d = r.get("delta", 0)\n                    d_str = f"+{d}" if d >= 0 else f"{d}"\n                lines.append(f"| {r[\'reason\']} | {r[\'count\']} | {b_cnt} | {d_str} |")\n        else:\n            lines.append("| Reason | Count |")\n            lines.append("| --- | --- |")\n            for r in reasons:\n                lines.append(f"| {r[\'reason\']} | {r[\'count\']} |")\n\n        if state.verbose and state.max_nodeids > 0:\n            lines.append("")\n            lines.append("## Node IDs")\n            lines.append("")\n            for r in reasons:\n                lines.append(f"### {r[\'reason\']}")\n                raw_nids = r.get("raw_nodeids", [])\n                for nid in raw_nids[: state.max_nodeids]:\n                    lines.append(f"- `{nid}`")\n                if len(raw_nids) > state.max_nodeids:\n                    diff = len(raw_nids) - state.max_nodeids\n                    lines.append(f"- `(+{diff} more)`")\n\n    return "\\n".join(lines) + "\\n"\n\n\ndef _format_html_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    lines = [\n        "<!DOCTYPE html>",\n        "<html>",\n        "<head><title>Deselection Report</title></head>",\n        "<body>",\n        "<h1>Deselection Report</h1>",\n        f"<p><strong>Total deselected:</strong> {state.total_deselected}</p>",\n    ]\n    if not reasons or state.total_deselected == 0:\n        lines.append("<p>No deselections recorded.</p>")\n    else:\n        lines.append("<table>")\n        if has_baseline:\n            lines.append("<tr><th>Reason</th><th>Count</th><th>Baseline</th><th>Delta</th></tr>")\n            for r in reasons:\n                b_cnt = r.get("baseline_count", 0)\n                if r.get("is_new"):\n                    d_str = "(new)"\n                else:\n                    d = r.get("delta", 0)\n                    d_str = f"+{d}" if d >= 0 else f"{d}"\n                lines.append(\n                    f"<tr><td>{html.escape(r[\'reason\'])}</td><td>{r[\'count\']}</td><td>{b_cnt}</td><td>{d_str}</td></tr>"\n                )\n        else:\n            lines.append("<tr><th>Reason</th><th>Count</th></tr>")\n            for r in reasons:\n                lines.append(f"<tr><td>{html.escape(r[\'reason\'])}</td><td>{r[\'count\']}</td></tr>")\n        lines.append("</table>")\n\n        if state.verbose and state.max_nodeids > 0:\n            lines.append("<h2>Node IDs</h2>")\n            for r in reasons:\n                lines.append(f"<h3>{html.escape(r[\'reason\'])}</h3>")\n                lines.append("<ul>")\n                raw_nids = r.get("raw_nodeids", [])\n                for nid in raw_nids[: state.max_nodeids]:\n                    lines.append(f"<li><code>{html.escape(nid)}</code></li>")\n                if len(raw_nids) > state.max_nodeids:\n                    diff = len(raw_nids) - state.max_nodeids\n                    lines.append(f"<li><code>(+{diff} more)</code></li>")\n                lines.append("</ul>")\n\n    lines.extend(["</body>", "</html>"])\n    return "\\n".join(lines) + "\\n"\n\n\ndef _parse_output_target(target: str, default_format: str) -> tuple[str, str]:\n    VALID_TOKENS = {"text", "json", "csv", "md", "markdown", "html", "htm"}\n    if ":" in target:\n        path_part, fmt_part = target.rsplit(":", 1)\n        fmt_lower = fmt_part.lower()\n        if fmt_lower in VALID_TOKENS:\n            if fmt_lower in ("markdown",):\n                fmt_lower = "md"\n            elif fmt_lower in ("htm",):\n                fmt_lower = "html"\n            return path_part, fmt_lower\n\n    p = pathlib.Path(target)\n    ext = p.suffix.lstrip(".").lower()\n    if ext in ("text", "txt"):\n        return target, "text"\n    elif ext == "json":\n        return target, "json"\n    elif ext == "csv":\n        return target, "csv"\n    elif ext in ("md", "markdown"):\n        return target, "md"\n    elif ext in ("html", "htm"):\n        return target, "html"\n    else:\n        return target, default_format\n\n\ndef _generate_report_str(state: ExplainDeselectionsState, reasons: list[dict[str, Any]], fmt: str) -> str:\n    if fmt == "text":\n        return _format_text_report(state, reasons)\n    elif fmt == "json":\n        return _format_json_report(state, reasons)\n    elif fmt == "csv":\n        return _format_csv_report(state, reasons)\n    elif fmt == "md":\n        return _format_md_report(state, reasons)\n    elif fmt == "html":\n        return _format_html_report(state, reasons)\n    else:\n        return _format_text_report(state, reasons)\n\n\ndef pytest_sessionfinish(session: Any, exitstatus: int) -> None:\n    state = session.config.stash.get(explain_deselections_key, None)\n    if state is None:\n        return\n\n    reasons = state.get_processed_reasons()\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    # 1. Fail on new check\n    if state.fail_on_new and has_baseline:\n        new_reasons = [r["reason"] for r in reasons if r.get("is_new")]\n        if new_reasons:\n            reasons_str = ", ".join(new_reasons)\n            print(f"NEW DESELECTION REASONS: {reasons_str}")\n            session.exitstatus = ExitCode.TESTS_FAILED\n\n    # 2. Threshold checks\n    M = state.total_deselected\n    if state.warn_if_exceeds is not None and M > state.warn_if_exceeds:\n        # Will print warning in terminal summary or here\n        pass\n\n    if state.fail_if_exceeds is not None and M > state.fail_if_exceeds:\n        session.exitstatus = ExitCode.TESTS_FAILED\n\n    # 3. Write outputs\n    for out_spec in state.outputs:\n        if out_spec == "-":\n            # stdout text report\n            content = _generate_report_str(state, reasons, "text")\n            if content:\n                print(content, end="")\n        else:\n            path_str, fmt = _parse_output_target(out_spec, state.format)\n            content = _generate_report_str(state, reasons, fmt)\n            abs_path = os.path.abspath(path_str)\n            os.makedirs(os.path.dirname(abs_path), exist_ok=True)\n            with open(abs_path, "w", encoding="utf-8") as f:\n                f.write(content)\n\n    # 4. Update baseline file\n    if state.update_baseline and state.baseline_file:\n        content = _format_json_report(state, state.get_processed_reasons())\n        abs_path = os.path.abspath(state.baseline_file)\n        os.makedirs(os.path.dirname(abs_path), exist_ok=True)\n        with open(abs_path, "w", encoding="utf-8") as f:\n            f.write(content)\n\n    # 5. JUnit XML handling\n    if state.junit != "none":\n        from _pytest.junitxml import xml_key\n        import xml.etree.ElementTree as ET\n\n        xml_obj = session.config.stash.get(xml_key, None)\n        if xml_obj is not None:\n            if state.junit == "properties":\n                # Add total\n                xml_obj.add_global_property("pytest.deselections.total", str(state.total_deselected))\n\n                seen_keys: set[str] = set()\n                for r in reasons:\n                    # Sanitize reason keeping only [A-Za-z0-9_.-]\n                    raw_r = r["reason"]\n                    sanitized = "".join(\n                        c for c in raw_r if c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-"\n                    )\n                    base_key = f"pytest.deselections.{sanitized}"\n                    prop_key = base_key\n                    idx = 1\n                    while prop_key in seen_keys:\n                        prop_key = f"{base_key}_{idx}"\n                        idx += 1\n                    seen_keys.add(prop_key)\n                    xml_obj.add_global_property(prop_key, str(r["count"]))\n\n            elif state.junit == "system-out":\n                # Intercept xml_obj.pytest_sessionfinish to append <system-out>\n                text_content = _format_text_report(state, reasons)\n                orig_finish = xml_obj.pytest_sessionfinish\n\n                def custom_finish() -> None:\n                    orig_finish()\n                    if os.path.exists(xml_obj.logfile):\n                        try:\n                            tree = ET.parse(xml_obj.logfile)\n                            root = tree.getroot()\n                            suite = root.find("testsuite") if root.tag == "testsuites" else root\n                            if suite is not None:\n                                sysout_elem = ET.Element("system-out")\n                                sysout_elem.text = text_content\n                                suite.append(sysout_elem)\n                                tree.write(xml_obj.logfile, encoding="utf-8", xml_declaration=True)\n                        except Exception:\n                            pass\n\n                xml_obj.pytest_sessionfinish = custom_finish\n\n\ndef pytest_terminal_summary(\n    terminalreporter: TerminalReporter, exitstatus: ExitCode, config: Config\n) -> None:\n    state = config.stash.get(explain_deselections_key, None)\n    if state is None:\n        return\n\n    reasons = state.get_processed_reasons()\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    # 1. Print reason lines (if any tests were deselected and reasons exist)\n    if state.total_deselected > 0 or reasons:\n        text_report = _format_text_report(state, reasons)\n        if text_report:\n            terminalreporter.write(text_report + ("\\n" if not text_report.endswith("\\n") else ""))\n\n    # 2. Print show-total\n    if state.show_total:\n        terminalreporter.write_line(f"Total deselected: {state.total_deselected}")\n\n    # 3. Print show-stats\n    if state.show_stats:\n        terminalreporter.write_line("Deselection statistics:")\n        terminalreporter.write_line(f"  total deselected: {state.total_deselected}")\n        distinct_reasons = len(reasons)\n        terminalreporter.write_line(f"  distinct reasons: {distinct_reasons}")\n\n        if distinct_reasons > 0:\n            counts = [r["count"] for r in reasons]\n            max_val = float(max(counts))\n            min_val = float(min(counts))\n            mean_val = float(sum(counts) / len(counts))\n\n            sorted_counts = sorted(counts)\n            n = len(sorted_counts)\n            if n % 2 == 1:\n                median_val = float(sorted_counts[n // 2])\n            else:\n                median_val = (sorted_counts[n // 2 - 1] + sorted_counts[n // 2]) / 2.0\n\n            terminalreporter.write_line(f"  max per reason: {max_val:.1f}")\n            terminalreporter.write_line(f"  min per reason: {min_val:.1f}")\n            terminalreporter.write_line(f"  mean per reason: {mean_val:.1f}")\n            terminalreporter.write_line(f"  median per reason: {median_val:.1f}")\n\n        if has_baseline:\n            total_delta = state.total_deselected - state.baseline_total\n            terminalreporter.write_line(f"  total delta: {total_delta}")\n\n            new_cnt = sum(1 for r in reasons if r.get("is_new"))\n            improved_cnt = sum(1 for r in reasons if not r.get("is_new") and r.get("delta", 0) < 0)\n            worsened_cnt = sum(1 for r in reasons if not r.get("is_new") and r.get("delta", 0) > 0)\n            unchanged_cnt = sum(1 for r in reasons if not r.get("is_new") and r.get("delta", 0) == 0)\n\n            terminalreporter.write_line(f"  new reasons: {new_cnt}")\n            terminalreporter.write_line(f"  improved reasons: {improved_cnt}")\n            terminalreporter.write_line(f"  worsened reasons: {worsened_cnt}")\n            terminalreporter.write_line(f"  unchanged reasons: {unchanged_cnt}")\n\n    # 4. Warnings and threshold exceeded messages\n    M = state.total_deselected\n    if state.warn_if_exceeds is not None and M > state.warn_if_exceeds:\n        terminalreporter.write_line(\n            f"DESELECTION WARNING: {M} tests deselected (warning threshold: {state.warn_if_exceeds})"\n        )\n\n    if state.fail_if_exceeds is not None and M > state.fail_if_exceeds:\n  