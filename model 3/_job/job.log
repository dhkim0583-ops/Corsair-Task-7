ctions_min_count",\n        "explain_deselections_format",\n        "explain_deselections_fail_if_exceeds",\n        "explain_deselections_max_nodeids",\n        "explain_deselections_nodeids_order",\n        "explain_deselections_junit",\n    ]\n    for opt in ini_opts:\n        val = config.getini(opt)\n        if val is not None and val != "":\n            return True\n\n    return False\n\n\ndef _parse_int_opt(val: Any, opt_name: str) -> int | None:\n    if val is None or val == "":\n        return None\n    try:\n        return int(val)\n    except (ValueError, TypeError):\n        raise UsageError(f"invalid integer value for {opt_name}: {val}")\n\n\nclass ExplainDeselectionsState:\n    def __init__(self, config: Config) -> None:\n        self.config = config\n\n        # Resolve options (CLI overrides INI)\n        self.verbose: bool = bool(config.getoption("explain_deselections_verbose"))\n        self.sort_by: str | None = config.getoption("explain_deselections_sort_by")\n        if self.sort_by and self.sort_by not in ("reason", "count", "delta"):\n            raise UsageError("choose from reason, count, delta")\n        if not self.sort_by:\n            self.sort_by = "reason"\n\n        self.show_total: bool = bool(config.getoption("explain_deselections_show_total"))\n        self.show_stats: bool = bool(config.getoption("explain_deselections_show_stats"))\n\n        self.reason_filter: str | None = config.getoption("explain_deselections_reason_filter")\n        if self.reason_filter:\n            try:\n                re.compile(self.reason_filter)\n            except re.error:\n                raise UsageError("invalid regex")\n\n        self.warn_if_exceeds: int | None = config.getoption("explain_deselections_warn_if_exceeds")\n        if self.warn_if_exceeds is not None and self.warn_if_exceeds < 0:\n            raise UsageError("must be >= 0")\n\n        fail_exceeds_cli = config.getoption("explain_deselections_fail_if_exceeds")\n        fail_exceeds_ini = config.getini("explain_deselections_fail_if_exceeds")\n        if fail_exceeds_cli is not None:\n            self.fail_if_exceeds = fail_exceeds_cli\n        elif fail_exceeds_ini is not None and fail_exceeds_ini != "":\n            self.fail_if_exceeds = _parse_int_opt(fail_exceeds_ini, "explain_deselections_fail_if_exceeds")\n        else:\n            self.fail_if_exceeds = None\n\n        if self.fail_if_exceeds is not None and self.fail_if_exceeds < 0:\n            raise UsageError("must be >= 0")\n\n        min_count_cli = config.getoption("explain_deselections_min_count")\n        min_count_ini = config.getini("explain_deselections_min_count")\n        if min_count_cli is not None:\n            self.min_count = min_count_cli\n        elif min_count_ini is not None and min_count_ini != "":\n            self.min_count = _parse_int_opt(min_count_ini, "explain_deselections_min_count")\n        else:\n            self.min_count = None\n\n        if self.min_count is not None and self.min_count < 1:\n            raise UsageError("must be >= 1")\n\n        self.reasons_cap: int | None = config.getoption("explain_deselections_reasons_cap")\n        if self.reasons_cap is not None and self.reasons_cap < 0:\n            raise UsageError("must be >= 0")\n\n        self.min_delta: int | None = config.getoption("explain_deselections_min_delta")\n        if self.min_delta is not None and self.min_delta < 0:\n            raise UsageError("must be >= 0")\n\n        self.outputs: list[str] = config.getoption("explain_deselections_output") or []\n\n        fmt_cli = config.getoption("explain_deselections_format")\n        fmt_ini = config.getini("explain_deselections_format")\n        fmt_val = fmt_cli if fmt_cli is not None else (fmt_ini if fmt_ini != "" else None)\n        if fmt_val is not None:\n            if fmt_val in ("md", "html", "markdown", "htm"):\n                raise UsageError("choose from text, json, csv")\n            if fmt_val not in ("text", "json",