s are present.\')\n    group.addoption(\'--explain-deselections-update-baseline\', action=\'store_true\', default=False, help=\'Update baseline report JSON file.\')\n\n    parser.addini(\'explain_deselections\', type=\'bool\', default=False, help=\'Enable explain deselections.\')\n    parser.addini(\'explain_deselections_min_count\', type=\'string\', default=None, help=\'Min count for explain deselections.\')\n    parser.addini(\'explain_deselections_format\', type=\'string\', default=None, help=\'Default format for explain deselections.\')\n    parser.addini(\'explain_deselections_fail_if_exceeds\', type=\'string\', default=None, help=\'Fail threshold for explain deselections.\')\n    parser.addini(\'explain_deselections_max_nodeids\', type=\'string\', default=None, help=\'Max node IDs for explain deselections.\')\n    parser.addini(\'explain_deselections_nodeids_order\', type=\'string\', default=None, help=\'Node IDs order for explain deselections.\')\n    parser.addini(\'explain_deselections_junit\', type=\'string\', default=None, help=\'JUnit mode for explain deselections.\')\n\ndef is_explain_deselections_enabled(config: Config) -> bool:\n    if config.getoption(\'explain_deselections\') or config.getini(\'explain_deselections\'):\n        return True\n    cli_opts = [\'explain_deselections_verbose\', \'explain_deselections_sort_by\', \'explain_deselections_show_total\', \'explain_deselections_show_stats\', \'explain_deselections_reason_filter\', \'explain_deselections_warn_if_exceeds\', \'explain_deselections_fail_if_exceeds\', \'explain_deselections_min_count\', \'explain_deselections_reasons_cap\', \'explain_deselections_min_delta\', \'explain_deselections_output\', \'explain_deselections_format\', \'explain_deselections_max_nodeids\', \'explain_deselections_nodeids_order\', \'explain_deselections_json_no_nodeids\', \'explain_deselections_json_pretty\', \'explain_deselections_csv_with_delta\', \'explain_deselections_junit\', \'explain_deselections_baseline\', \'explain_deselections_fail_on_new\', \'explain_deselections_update_baseline\']\n    for opt in cli_opts:\n        val = config.getoption(opt)\n        if val is not None and val is not False:\n            return True\n    ini_opts = [\'explain_deselections_min_count\', \'explain_deselections_format\', \'explain_deselections_fail_if_exceeds\', \'explain_deselections_max_nodeids\', \'explain_deselections_nodeids_order\', \'explain_deselections_junit\']\n    for opt in ini_opts:\n        val = config.getini(opt)\n        if val is not None and val != \'\':\n            return True\n    return False\n\ndef _parse_int_opt(val: Any, opt_name: str) -> int:\n    if val is None or val == \'\':\n        return 0\n    try:\n        return int(val)\n    except (ValueError, TypeError):\n        raise UsageError(f\'invalid integer value for {opt_name}: {val}\')\n\nclass ExplainDeselectionsState:\n    def __init__(self, config: Config) -> None:\n        self.config = config\n        self.verbose: bool = bool(config.getoption(\'explain_deselections_verbose\'))\n        self.sort_by: str | None = config.getoption(\'explain_deselections_sort_by\')\n        if self.sort_by and self.sort_by not in (\'reason\', \'count\', \'delta\'):\n            raise UsageError(\'choose from reason, count, delta\')\n        if not self.sort_by:\n            self.sort_by = \'reason\'\n        self.show_total: bool = bool(config.getoption(\'explain_deselections_show_total\'))\n        self.show_stats: bool = bool(config.getoption(\'explain_deselections_show_stats\'))\n        self.reason_filter: str | None = config.getoption(\'explain_deselections_reason_filter\')\n        if self.reason_filter:\n            try:\n                re.compile(self.reason_filter)\n            except re.error:\n                raise UsageError(\'invalid regex\')\n        self.warn_if_exceeds: int | None = config.getoption(\'explain_deselections_warn_if_exceeds\')\n        if self.warn_if_exceeds is not None and self.warn_if_exceeds < 0:\n            raise UsageError(\'must be >= 0\')\n        fail_exceeds_cli = config.getoption(\'explain_deselections_fail_if_exceeds\')\n        fail_exceeds_ini = config.getini(\'explain_deselections_fail_if_exceeds\')\n        if fail_exceeds_cli is not None:\n            self.fail_if_exceeds = fail_exceeds_cli\n        elif fail_exceeds_ini is not None and fail_exceeds_ini != \'\':\n            self.fail_if_exceeds = _parse_int_opt(fail_exceeds_ini, \'explain_deselections_fail_if_exceeds\')\n        else:\n            self.fail_if_exceeds = None\n        if self.fail_if_exceeds is not None and self.fail_if_exceeds < 0:\n            raise UsageError(\'must be >= 0\')\n        min_count_cli = config.getoption(\'explain_deselections_min_count\')\n        min_count_ini = config.getini(\'explain_deselections_min_count\')\n        if min_count_cli is not None:\n            self.min_count = min_count_cli\n        elif min_count_ini is not None and min_count_ini != \'\':\n            self.min_count = _parse_int_opt(min_count_ini, \'explain_deselections_min_count\')\n        else:\n            self.min_count = None\n        if self.min_count is not None and self.min_count < 1:\n            raise UsageError(\'must be >= 1\')\n        self.reasons_cap: int | None = config.getoption(\'explain_deselections_reasons_cap\')\n        if self.reasons_cap is not None and self.reasons_cap < 0:\n            raise UsageError(\'must be >= 0\')\n        self.min_delta: int | None = config.getoption(\'explain_deselections_min_delta\')\n        if self.min_delta is not None and self.min_delta < 0:\n            raise UsageError(\'must be >= 0\')\n        self.outputs: list[str] = config.getoption(\'explain_deselections_output\') or []\n        fmt_cli = config.getoption(\'explain_deselections_format\')\n        fmt_ini = config.getini(\'explain_deselections_format\')\n        fmt_val = fmt_cli if fmt_cli is not None else (fmt_ini if fmt_ini != \'\' else None)\n        if fmt_val is not None:\n            if fmt_val in (\'md\', \'html\', \'markdown\', \'htm\'):\n                raise UsageError(\'choose from text, json, csv\')\n            if fmt_val not in (\'text\', \'json\', \'csv\'):\n                raise UsageError(\'choose from text, json, csv\')\n            self.format = fmt_val\n        else:\n            self.format = \'text\'\n        if (self.format in (\'json\', \'csv\') or fmt_cli in (\'json\', \'csv\') or (fmt_ini and fmt_ini in (\'json\', \'csv\'))) and not self.outputs:\n            raise UsageError(\'requires --explain-deselections-output\')\n        max_nodeids_cli = config.getoption(\'explain_deselections_max_nodeids\')\n        max_nodeids_ini = config.getini(\'explain_deselections_max_nodeids\')\n        if max_nodeids_cli is not None:\n            self.max_nodeids = max_nodeids_cli\n        elif max_nodeids_ini is not None and max_nodeids_ini != \'\':\n            self.max_nodeids = _parse_int_opt(max_nodeids_ini, \'explain_deselections_max_nodeids\')\n        else:\n            self.max_nodeids = 0\n        if self.max_nodeids < 0:\n            raise UsageError(\'must be >= 0\')\n        order_cli = config.getoption(\'explain_deselections_nodeids_order\')\n        order_ini = config.getini(\'explain_deselections_nodeids_order\')\n        order_val = order_cli if order_cli is not None else (order_ini if order_ini != \'\' else None)\n        if order_val is not None:\n            if order_val not in (\'encountered\', \'sorted\'):\n                raise UsageError(\'choose from encountered, sorted\')\n            self.nodeids_order = order_val\n        else:\n            self.nodeids_order = \'encountered\'\n        self.json_no_nodeids: bool = bool(config.getoption(\'explain_deselections_json_no_nodeids\'))\n        self.json_pretty: bool = bool(config.getoption(\'explain_deselections_json_pretty\'))\n        self.csv_with_delta: bool = bool(config.getoption(\'explain_deselections_csv_with_delta\'))\n        junit_cli = config.getoption(\'explain_deselections_junit\')\n        junit_ini = config.getini(\'explain_deselections_junit\')\n        junit_val = junit_cli if junit_cli is not None else (junit_ini if junit_ini != \'\' else None)\n        if junit_val is not None:\n            if junit_val not in (\'none\', \'properties\', \'system-out\'):\n                raise UsageError(\'choose from none, properties, system-out\')\n            self.junit = junit_val\n        else:\n            self.junit = \'none\'\n        xmlpath = config.option.xmlpath\n        if self.junit != \'none\' and not xmlpath:\n            raise UsageError(\'requires --junitxml\')\n        self.baseline_file: str | None = config.getoption(\'explain_deselections_baseline\')\n        self.fail_on_new: bool = bool(config.getoption(\'explain_deselections_fail_on_new\'))\n        self.update_baseline: bool = bool(config.getoption(\'explain_deselections_update_baseline\'))\n        if self.min_delta is not None and not self.baseline_file:\n            raise UsageError(\'requires --explain-deselections-baseline\')\n        if self.fail_on_new and not self.baseline_file:\n            raise UsageError(\'requires --explain-deselections-baseline\')\n        if self.update_baseline and not self.baseline_file:\n            raise UsageError(\'requires --explain-deselections-baseline\')\n        self.baseline_data: dict[str, Any] | None = None\n        self.baseline_reasons: dict[str, int] = {}\n        self.baseline_total: int = 0\n        if self.baseline_file:\n            if not os.path.exists(self.baseline_file):\n                if not self.update_baseline:\n                    raise UsageError(\'file not found\')\n            else:\n                try:\n                    with open(self.baseline_file, encoding=\'utf-8\') as f:\n                        self.baseline_data = json.load(f)\n                except Exception:\n                    raise UsageError(\'invalid JSON\')\n                if not isinstance(self.baseline_data, dict):\n                    raise UsageError(\'invalid JSON\')\n                self.baseline_total = self.baseline_data.get(\'total_deselected\', 0)\n                reasons_arr = self.baseline_data.get(\'reasons\', [])\n                if isinstance(reasons_arr, list):\n                    for r_item in reasons_arr:\n                        if isinstance(r_item, dict) and \'reason\' in r_item and \'count\' in r_item:\n                            self.baseline_reasons[r_item[\'reason\']] = r_item[\'count\']\n        self.deselected_by_reason: collections.OrderedDict[str, list[str]] = collections.OrderedDict()\n        self.total_deselected: int = 0\n\n    def record_deselected(self, reason: str, items: Sequence[Item]) -> None:\n        if reason not in self.deselected_by_reason:\n            self.deselected_by_reason[reason] = []\n        nodeids = [item.nodeid for item in items]\n        self.deselected_by_reason[reason].extend(nodeids)\n        self.total_deselected += len(items)\n\n    def get_processed_reasons(self) -> list[dict[str, Any]]:\n        has_baseline = self.baseline_file is not None and (self.baseline_data is not None or self.update_baseline)\n        raw_reasons = []\n        for reason, nids in self.deselected_by_reason.items():\n            if self.nodeids_order == \'sorted\':\n                ordered_nids = sorted(nids)\n            else:\n                ordered_nids = list(nids)\n            cnt = len(nids)\n            r_info: dict[str, Any] = {\n                \'reason\': reason,\n                \'count\': cnt,\n                \'raw_nodeids\': ordered_nids,\n                \'nodeids\': ordered_nids[: self.max_nodeids] if self.max_nodeids > 0 else [],\n            }\n            if has_baseline:\n                if reason in self.baseline_reasons:\n                    b_cnt = self.baseline_reasons[reason]\n                    r_info[\'baseline_count\'] = b_cnt\n                    r_info[\'delta\'] = cnt - b_cnt\n                    r_info[\'is_new\'] = False\n                else:\n                    r_info[\'baseline_count\'] = 0\n                    r_info[\'delta\'] = cnt\n                    r_info[\'is_new\'] = True\n            raw_reasons.append(r_info)\n\n        if self.reason_filter:\n            pattern = re.compile(self.reason_filter)\n            raw_reasons = [r for r in raw_reasons if pattern.search(r[\'reason\'])]\n\n        if self.min_count is not None:\n            raw_reasons = [r for r in raw_reasons if r[\'count\'] >= self.min_count]\n\n        if self.min_delta is not None and has_baseline:\n            raw_reasons = [r for r in raw_reasons if abs(r[\'delta\']) >= self.min_delta]\n\n        if self.sort_by == \'reason\':\n            raw_reasons.sort(key=lambda r: r[\'reason\'])\n        elif self.sort_by == \'count\':\n            raw_reasons.sort(key=lambda r: (-r[\'count\'], r[\'reason\']))\n        elif self.sort_by == \'delta\':\n            def delta_key(r: dict[str, Any]) -> tuple[int, str]:\n                d = r.get(\'delta\', r[\'count\']) if has_baseline else r[\'count\']\n                return (-d, r[\'reason\'])\n            raw_reasons.sort(key=delta_key)\n\n        if self.reasons_cap is not None and self.reasons_cap > 0:\n            raw_reasons = raw_reasons[: self.reasons_cap]\n\n        return raw_reasons\n\ndef pytest_configure(config: Config) -> None:\n    if is_explain_deselections_enabled(config):\n        state = ExplainDeselectionsState(config)\n        config.stash[explain_deselections_key] = state\n\n@hookimpl(tryfirst=True)\ndef pytest_collection_modifyitems(items: list[Item], config: Config) -> None:\n    state = config.stash.get(explain_deselections_key, None)\n    if state is None:\n        return\n\n    deselect_prefixes = config.getoption(\'deselect\') or []\n    keywordexpr = config.option.keyword.lstrip() if config.option.keyword else \'\'\n    markexpr = config.option.markexpr or \'\'\n\n    k_expr = _parse_expression(keywordexpr, "Wrong expression passed to \'-k\'") if keywordexpr else None\n    m_expr = _parse_expression(markexpr, "Wrong expression passed to \'-m\'") if markexpr else None\n\n    remaining: list[Item] = []\n    deselected_by_reason: collections.OrderedDict[str, list[Item]] = collections.OrderedDict()\n\n    for item in items:\n        deselected_reason = None\n        for prefix in deselect_prefixes:\n            if item.nodeid.startswith(prefix):\n                deselected_reason = f\'--deselect {prefix}\'\n                break\n\n        if deselected_reason is None and k_expr is not None:\n            if not k_expr.evaluate(KeywordMatcher.from_item(item)):\n                deselected_reason = f\'-k {keywordexpr}\'\n\n        if deselected_reason is None and m_expr is not None:\n            if not m_expr.evaluate(MarkMatcher.from_markers(item.iter_markers())):\n                deselected_reason = f\'-m {markexpr}\'\n\n        if deselected_reason is not None:\n            if deselected_reason not in deselected_by_reason:\n                deselected_by_reason[deselected_reason] = []\n            deselected_by_reason[deselected_reason].append(item)\n        else:\n            remaining.append(item)\n\n    all_deselected = []\n    for reason, des_items in deselected_by_reason.items():\n        state.record_deselected(reason, des_items)\n        all_deselected.extend(des_items)\n\n    if all_deselected:\n        config.hook.pytest_deselected(items=all_deselected)\n        items[:] = remaining\n\ndef _format_text_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n    lines = []\n\n    for r in reasons:\n        line = f"deselected by {r[\'reason\']}: {r[\'count\']}"\n        if has_baseline:\n            if r.get(\'is_new\'):\n                line += \' (new)\'\n            else:\n                d = r.get(\'delta\', 0)\n                if d >= 0:\n                    line += f\' (+{d})\'\n                else:\n                    line += f\' ({d})\'\n        lines.append(line)\n\n        if state.verbose and state.max_nodeids > 0 and r.get(\'raw_nodeids\'):\n            raw_nids = r[\'raw_nodeids\']\n            for nid in raw_nids[: state.max_nodeids]:\n                lines.append(f\'  {nid}\')\n            if len(raw_nids) > state.max_nodeids:\n                diff = len(raw_nids) - state.max_nodeids\n                lines.append(f\'  (+{diff} more)\')\n\n    return \'\\n\'.join(lines)\n\ndef _format_json_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    data: dict[str, Any] = {\n        \'schema_version\': 1,\n        \'total_deselected\': state.total_deselected,\n    }\n    if has_baseline:\n        data[\'baseline_total_deselected\'] = state.baseline_total\n        data[\'total_delta\'] = state.total_deselected - state.baseline_total\n\n    reasons_list = []\n    for r in reasons:\n        rec: dict[str, Any] = {\n            \'reason\': r[\'reason\'],\n            \'count\': r[\'count\'],\n        }\n        if not state.json_no_nodeids:\n            if state.max_nodeids > 0:\n                rec[\'nodeids\'] = r[\'raw_nodeids\'][: state.max_nodeids]\n            else:\n                rec[\'nodeids\'] = []\n        if has_baseline:\n            rec[\'baseline_count\'] = r.get(\'baseline_count\', 0)\n            rec[\'delta\'] = r.get(\'delta\', r[\'count\'])\n        reasons_list.append(rec)\n\n    data[\'reasons\'] = reasons_list\n\n    if state.json_pretty:\n        return json.dumps(data, indent=2) + \'\\n\'\n    else:\n        return json.dumps(data) + \'\\n\'\n\ndef _format_csv_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n    include_delta = state.csv_with_delta\n\n    out = io.StringIO()\n    writer = csv.writer(out)\n\n    if include_delta:\n        writer.writerow([\'reason\', \'count\', \'baseline_count\', \'delta\'])\n        for r in reasons:\n            writer.writerow([\n                r[\'reason\'],\n                r[\'count\'],\n                r.get(\'baseline_count\', 0) if has_baseline else 0,\n                r.get(\'delta\', r[\'count\']) if has_baseline else r[\'count\'],\n            ])\n    else:\n        writer.writerow([\'reason\', \'count\'])\n        for r in reasons:\n            writer.writerow([r[\'reason\'], r[\'count\']])\n\n    return out.getvalue()\n\ndef _format_md_report(state: ExplainDeselectionsState, reasons: list[dict[str, Any]]) -> str:\n    has_baseline = state.baseline_file is not None and (state.baseline_data is not None or state.update_baseline)\n\n    lines = [\n        \'# Deselection Report\',\n        \'\',\n        f\'**Total deselected:** {state.total_deselected}\',\n        \'\',\n    ]\n    if not reasons or state.total_deselected == 0:\n        lines.append(\'No deselections recorded.\')\n    else:\n        if has_baseline:\n            lines.append(\'| Reason | Count | Baseline | Delta |\')\n            lines.append(\'| --- | --- | --- | --- |\')\n            for r in reasons:\n                b_cnt = r.get(\'baseline_count\', 0)\n                if r.get(\'is_new\'):\n                    d_str = \'(new)\'\n                else:\n                    d = r.get(\'delta\', 0)\n                    d_str = f\'+{d}\' if d >= 0 else f\'{d}\'\n                lines.append(f"| {r[\'reason\']} | {r[\'count\']} | {b_cnt} | {d_str} |")\n        else:\n            lines.append(\'| Reason | Count |\')\n            lines.append(\'| --- | --- |\')\n            for r in reasons:\n                lines.append(f"| {r[\'reason\']} | {r[\'count\']} |")\n\n        if state.verbose and state.max_nodeid